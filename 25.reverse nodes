class Solution {
    public ListNode reverseKGroup(ListNode head, int k) {

        ListNode temp = head;
        int count = 0;

        // Check whether k nodes are available
        while (temp != null && count < k) {
            temp = temp.next;
            count++;
        }

        // Reverse only if k nodes are available
        if (count == k) {

            ListNode prev = null;
            ListNode curr = head;
            ListNode next = null;

            count = 0;

            while (curr != null && count < k) {
                next = curr.next;
                curr.next = prev;
                prev = curr;
                curr = next;
                count++;
            }

            // Recursively process remaining nodes
            head.next = reverseKGroup(curr, k);

            return prev;
        }

        return head;
    }
}
